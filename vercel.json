{
  "buildCommand": "node scripts/check-formal-verification-receipt.mjs",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/whitepaper",
      "destination": "/whitepaper.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "getmentis.ai" }],
      "destination": "https://dominusos.ai/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.getmentis.ai" }],
      "destination": "https://dominusos.ai/$1",
      "permanent": true
    }
  ]
}
