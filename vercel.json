{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [
    {
      "source": "/whitepaper",
      "destination": "/whitepaper.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "getmentis.ai" }],
      "destination": "https://dominusos.ai/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.getmentis.ai" }],
      "destination": "https://dominusos.ai/$1",
      "permanent": true
    },
    {
      "source": "/DominusOS_White_Paper_v2.pdf",
      "destination": "/DominusOS_White_Paper_v3.pdf",
      "permanent": true
    },
    {
      "source": "/docs/Dominus_OS_Public_Thesis_White_Paper_v0_2.pdf",
      "destination": "/docs/Dominus_OS_Public_Thesis_White_Paper_v0_2.md",
      "permanent": true
    },
    {
      "source": "/docs/Dominus_OS_Public_Thesis_White_Paper_v0_3.pdf",
      "destination": "/docs/Dominus_OS_Public_Thesis_White_Paper_v0_3.md",
      "permanent": true
    }
  ]
}
